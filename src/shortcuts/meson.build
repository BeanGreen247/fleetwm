# GTK-free keyboard-shortcuts window: lists every binding (as remapped in
# keybinds.toml) for the active window layout, with a link to the docs.
executable(
  'fleetwm-shortcuts',
  files('main.cpp'),
  include_directories: include_directories('.'),
  dependencies: [libfleetkit_dep, libcommon_core_dep],
  install: true,
)
